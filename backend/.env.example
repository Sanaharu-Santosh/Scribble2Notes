# Copy to backend/.env and edit. Never commit the real file.

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Engine selection — the only lines that change when you swap providers.
# ---------------------------------------------------------------------------
# mock         : generated output, no credentials needed (the default)
# fixture      : replay a saved response — real output, no quota, no network
# cloud_vision : Google Cloud Vision (see docs/cloud-vision-setup.md)
# paddle       : self-hosted PaddleOCR
# crnn         : the from-scratch model, fully offline. Needs
#                requirements-crnn.txt. Lowercase a-z only and ~51% CER on a
#                real page — read docs/crnn-engine.md before choosing it.
OCR_ENGINE=mock

# greedy is the default even though beam search is implemented: measured, beam
# scored worse on this model. See docs/crnn-engine.md.
CRNN_DECODER=greedy

# line : group words into lines — selecting a whole line feels much better
# word : raw detection granularity, for diagnosing bad line grouping
OCR_GRANULARITY=line

# Used when OCR_ENGINE=fixture. Capture one with:
#   python scripts/try_engine.py --image page.jpg --engine cloud_vision --save-fixture
OCR_FIXTURE_PATH=fixtures/lens_fixture.json

# opencv      : classical CV — ruled tables, boxes, underlines, highlights.
#               No weights, no GPU, no credentials. The default, and the right
#               fit for notes, where tables are ruled with a pen.
# mock        : generated output, for the zero-setup demo and for tests
# ppstructure : self-hosted PP-StructureV3 — not implemented, see its docstring
# azure       : Azure AI Document Intelligence Layout — not implemented
LAYOUT_ENGINE=opencv

# The opencv engine finds structure but cannot read. When true it asks whichever
# OCR_ENGINE is configured for the words and files them into the blocks and
# cells it found. Set false for geometry only (faster, and no API calls).
LAYOUT_FILL_TEXT=true

# ---------------------------------------------------------------------------
# Google Cloud Vision — first 1,000 images/month are free.
# Full walkthrough: docs/cloud-vision-setup.md
#
# For local development prefer `gcloud auth application-default login` and LEAVE
# THE LINE BELOW COMMENTED OUT — application default credentials are only used
# when GOOGLE_APPLICATION_CREDENTIALS is unset, so a leftover path silently
# overrides your login. Use a key file for deployment (Phase 7).
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------------------------------------------------------------------------
# Azure AI Document Intelligence — 500 pages/month free tier.
# ---------------------------------------------------------------------------
# AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DI_KEY=

# ---------------------------------------------------------------------------
# PaddleOCR (self-hosted)
# ---------------------------------------------------------------------------
PADDLE_LANG=en
PADDLE_USE_GPU=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Persistence
#
# Saving pages needs PostgreSQL. `docker compose up` starts one; otherwise run
# your own and create the database, then: alembic upgrade head
#
# Paste a provider's connection string exactly as given. postgres:// schemes,
# ?sslmode=require and ?channel_binding=require are all normalised at startup,
# because asyncpg rejects every one of them as written.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://scribble:scribble@localhost:5432/scribble2notes
DATABASE_ECHO=false

# local : scans on disk under STORAGE_LOCAL_DIR. Fine for development and for a
#         single-box deploy. Note most managed hosts have an ephemeral disk —
#         anything written here is gone on the next restart.
# s3    : any S3-compatible bucket. Written but never run; see
#         app/services/storage/s3.py before trusting it.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage

# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # Cloudflare R2
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# There is no sign-in yet: every request is this one account. See
# app/services/auth.py — that is where a real provider drops in.
DEV_USER_EMAIL=you@localhost
