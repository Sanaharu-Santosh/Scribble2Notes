# Copy to backend/.env and edit. Never commit the real file.

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Engine selection — the only lines that change when you swap providers.
# ---------------------------------------------------------------------------
# mock         : generated output, no credentials needed (the default)
# fixture      : replay a saved response — real output, no quota, no network
# cloud_vision : Google Cloud Vision (see docs/cloud-vision-setup.md)
# paddle       : self-hosted PaddleOCR
OCR_ENGINE=mock

# line : group words into lines — selecting a whole line feels much better
# word : raw detection granularity, for diagnosing bad line grouping
OCR_GRANULARITY=line

# Used when OCR_ENGINE=fixture. Capture one with:
#   python scripts/try_engine.py --image page.jpg --engine cloud_vision --save-fixture
OCR_FIXTURE_PATH=fixtures/lens_fixture.json

# mock        : generated output (Phase 0 default)
# ppstructure : self-hosted PP-StructureV3  (Phase 2)
# azure       : Azure AI Document Intelligence Layout  (Phase 2)
LAYOUT_ENGINE=mock

# ---------------------------------------------------------------------------
# Google Cloud Vision — first 1,000 images/month are free.
# Full walkthrough: docs/cloud-vision-setup.md
#
# For local development prefer `gcloud auth application-default login` and LEAVE
# THE LINE BELOW COMMENTED OUT — application default credentials are only used
# when GOOGLE_APPLICATION_CREDENTIALS is unset, so a leftover path silently
# overrides your login. Use a key file for deployment (Phase 7).
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------------------------------------------------------------------------
# Azure AI Document Intelligence — 500 pages/month free tier.
# ---------------------------------------------------------------------------
# AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DI_KEY=

# ---------------------------------------------------------------------------
# PaddleOCR (self-hosted)
# ---------------------------------------------------------------------------
PADDLE_LANG=en
PADDLE_USE_GPU=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
